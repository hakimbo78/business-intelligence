# ============================================
# AI Location Business Intelligence
# Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API in production.
# Required when NODE_ENV=production; ignored otherwise.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# --- Database ---
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/location_intelligence?schema=public

# --- Provider Selection ---
# Which location data provider to use.
# Options: mock | google
# Development MUST stay on mock (DEVELOPMENT_RULES.md §6) — `google` spends real quota.
MAP_PROVIDER=mock

# --- Google Maps (required only when MAP_PROVIDER=google) ---
# GOOGLE_MAPS_API_KEY=your-api-key-here

# --- AI Provider ---
# Which LLM provider the agents use.
# Options: mock | gemini | openrouter
# Development MUST stay on mock — the other options are billed per call.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Required only when AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-api-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini
