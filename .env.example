# ============================================
# AI Location Business Intelligence
# Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API in production.
# Required when NODE_ENV=production; ignored otherwise.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# --- Pricing (PROJECT_MASTER_SPEC.md §29: pricing must be configurable) ---
# Whole IDR. Placeholder defaults apply until these are set, and the API
# flags a quote as "isDefault" so nobody mistakes one for a real price.
# PRICE_VALIDATION=1500000
# PRICE_COMPARISON=2500000
# PRICE_AREA_SCOUTING=3500000

# --- Payment (manual bank transfer) ---
# Where clients send the transfer. Until all three are set the dashboard tells
# the client that payment is not set up, rather than showing a blank account.
# BANK_NAME=BCA
# BANK_ACCOUNT_NUMBER=1234567890
# BANK_ACCOUNT_HOLDER=Your Company Name

# --- Authentication ---
# The dashboard signs in with Google; the API verifies the resulting ID token.
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your dashboard
# origin to "Authorised JavaScript origins".
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Signing key for our own session tokens. At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# A leaked or guessable value means anyone can forge an owner session.
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h

# Comma-separated addresses granted the OWNER role (sees every client's orders).
# Everyone else who signs in becomes a CLIENT, limited to their own orders.
# Nobody can promote themselves by signing in.
OWNER_EMAILS=you@yourcompany.com

# Local development only — skips sign-in and treats every request as the owner.
# Refused when NODE_ENV=production.
# AUTH_DISABLED=true

# --- Database ---
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/location_intelligence?schema=public

# --- Provider Selection ---
# Which location data provider to use.
# Options: mock | google
# Development MUST stay on mock (DEVELOPMENT_RULES.md §6) — `google` spends real quota.
MAP_PROVIDER=mock

# --- Google Maps (required only when MAP_PROVIDER=google) ---
# GOOGLE_MAPS_API_KEY=your-api-key-here

# Include a Street View photograph of the frontage and a map with the
# competitors pinned.
#
# These two products (Street View Static, Maps Static) are the only billed
# Google APIs the platform uses: they refuse a demo key and require billing
# enabled on the Cloud project. Each comes with 10,000 free requests a month,
# and a report uses at most one of each, so the free allowance covers roughly
# 10,000 reports a month before anything is charged. Beyond that: Street View
# $7 / 1,000 and Static Maps $2 / 1,000. The metadata lookup that runs first is
# free and unmetered.
#
# Left false, the report prints a note in place of the photograph instead of
# failing.
# ENABLE_LOCATION_IMAGERY=false

# --- AI Provider ---
# Which LLM provider the agents use.
# Options: mock | gemini | openrouter
# Development MUST stay on mock — the other options are billed per call.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Required only when AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-api-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini
