{
  "name": "location-intelligence",
  "version": "0.1.0",
  "description": "AI-powered Location Decision Intelligence Platform for UMKM",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/ scripts/",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakimbo78/business-intelligence.git"
  },
  "keywords": [
    "location-intelligence",
    "umkm",
    "business-intelligence",
    "ai"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/hakimbo78/business-intelligence/issues"
  },
  "homepage": "https://github.com/hakimbo78/business-intelligence#readme",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@google/genai": "^2.23.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "puppeteer": "^25.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
