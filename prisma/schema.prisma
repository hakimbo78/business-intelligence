// Prisma Schema for AI Location Business Intelligence
// Phase 1: Domain Model entities (Client, Project, BusinessProfile, etc.)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

/// System metadata table for health checks and database verification.
model SystemInfo {
  id        String   @id @default("system")
  version   String   @default("0.1.0")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_info")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  company   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects  Project[]
  users     User[]

  @@map("clients")
}

/// A person who can sign in.
///
/// Identity comes from Google — we never store a password. Role decides reach:
/// OWNER sees every order, CLIENT sees only the orders belonging to their own
/// Client record (PROJECT_MASTER_SPEC.md §26, §27).
///
/// OWNER is never self-assigned: it is granted only to addresses on the
/// OWNER_EMAILS allow-list, checked at sign-in.
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String?
  /// Google's stable subject identifier. Email can change; this cannot.
  googleSub   String?   @unique @map("google_sub")
  role        String    @default("CLIENT") // OWNER | CLIENT
  /// The Client whose orders this user may see. Null for OWNER.
  clientId    String?   @map("client_id")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  name        String
  /// Which of the three products this order is (see lib/project-types.ts):
  /// VALIDATION      — client has one specific premises; we assess it.
  /// COMPARISON      — client has several premises; we rank them.
  /// AREA_SCOUTING   — client has only an area; we recommend micro-areas.
  /// The three need different pipelines, so this drives the orchestrator.
  projectType String   @default("AREA_SCOUTING") @map("project_type")
  status      String   @default("DRAFT") // DRAFT, INTAKE, RESEARCH, ANALYSIS, REVIEW, DELIVERED, FAILED
  /// Why a FAILED project stopped, in words the owner can act on.
  ///
  /// Without this a permanently failed job left the project sitting at its last
  /// status, indistinguishable from one still running.
  failureReason String? @map("failure_reason")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  researchPlan Json?   @map("research_plan")
  competitionAnalysis Json? @map("competition_analysis")
  demandAnalysis Json? @map("demand_analysis")
  marketGapAnalysis Json? @map("market_gap_analysis")
  accessibilityAnalysis Json? @map("accessibility_analysis")
  financialAnalysis Json? @map("financial_analysis")
  scoringAnalysis Json? @map("scoring_analysis")

  payment         Payment?
  businessProfile BusinessProfile?
  locationSearch  LocationSearch?
  candidates      LocationCandidate[]
  competitors     Competitor[]
  reports         Report[]
  dataSources     DataSource[]
  propertyListings PropertyListing[]

  @@map("projects")
}

/// Payment for one order.
///
/// The analysis pipeline calls paid LLM and maps APIs, so it must never run on
/// an unpaid order. Work begins only once an owner has verified the transfer:
///
///   AWAITING_PAYMENT -> AWAITING_CONFIRMATION -> APPROVED
///                                             -> REJECTED
///
/// Payment is currently a manual bank transfer the owner reconciles against
/// their own statement, so the client submits a reference rather than the money
/// passing through this system.
model Payment {
  id             String    @id @default(uuid())
  projectId      String    @unique @map("project_id")
  clientId       String    @map("client_id")

  /// Price quoted when the order was placed, kept even if the price list later
  /// changes, so an old invoice still says what the client actually owed.
  amount         Float
  currency       String    @default("IDR")
  method         String    @default("BANK_TRANSFER")

  status         String    @default("AWAITING_PAYMENT")

  /// What the client says they sent: sender name, bank, transfer reference.
  senderName     String?   @map("sender_name")
  senderBank     String?   @map("sender_bank")
  reference      String?
  transferredAt  DateTime? @map("transferred_at")
  confirmedAt    DateTime? @map("confirmed_at")

  /// Owner's decision.
  approvedAt     DateTime? @map("approved_at")
  approvedBy     String?   @map("approved_by")
  rejectedReason String?   @map("rejected_reason")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([clientId])
  @@map("payments")
}

model BusinessProfile {
  id                          String   @id @default(uuid())
  projectId                   String   @unique @map("project_id")
  businessName                String   @map("business_name")
  businessCategory            String   @map("business_category")
  businessSubcategory         String?  @map("business_subcategory")
  currentBranchCount          Int      @default(0) @map("current_branch_count")
  currentAverageTransaction   Float?   @map("current_average_transaction")
  estimatedDailyCustomers     Int?     @map("estimated_daily_customers")
  operatingDays               Int?     @map("operating_days")
  grossMargin                 Float?   @map("gross_margin")
  /// Monthly operating cost excluding rent: staff, utilities, supplies.
  /// Without it, operating profit is gross profit less rent only and every
  /// report reads optimistically in the same direction.
  operatingCostMonthly        Float?   @map("operating_cost_monthly")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  project                     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model LocationSearch {
  id                        String   @id @default(uuid())
  projectId                 String   @unique @map("project_id")
  targetCity                String   @map("target_city")
  targetArea                String?  @map("target_area")
  preferredRadius           Int?     @map("preferred_radius") // in meters
  /// The size the customer is aiming for, used for rent/sqm modelling.
  targetPropertySize        Int?     @map("target_property_size") // in sqm
  /// Hard floor for candidate filtering (PROJECT_MASTER_SPEC.md §4).
  /// Distinct from targetPropertySize: a target is an aim, not a rejection threshold.
  minimumPropertySize       Int?     @map("minimum_property_size") // in sqm
  /// Hard ceiling for candidate filtering (PROJECT_MASTER_SPEC.md §4).
  maximumPropertySize       Int?     @map("maximum_property_size") // in sqm
  maximumMonthlyRent        Float?   @map("maximum_monthly_rent")
  /// Budget ceiling used to filter candidates out (PROJECT_MASTER_SPEC.md §4).
  maximumInitialInvestment  Float?   @map("maximum_initial_investment")
  /// Total Initial Investment the customer actually plans to spend before
  /// opening: deposit, renovation, equipment, furniture, signage, permits and
  /// opening stock (PROJECT_MASTER_SPEC.md §12). Excludes rent, which is an
  /// operating cost. This is the payback-period numerator, so it is required
  /// before financial analysis can run.
  estimatedInitialInvestment Float?  @map("estimated_initial_investment")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  project                   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("location_searches")
}

model LocationCandidate {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  placeId         String?  @map("place_id") // External provider ID (e.g. Google Maps Place ID)
  name            String
  address         String
  latitude        Float
  longitude       Float
  geom            Unsupported("geometry(Point, 4326)")?
  
  /// Supplied by the client for VALIDATION and COMPARISON projects.
  /// Never inferred from surrounding prices — absent data stays null.
  estimatedRent   Float?   @map("estimated_rent")
  propertySize    Int?     @map("property_size")
  propertyType    String?  @map("property_type")
  /// Which listing supplied the figures above, so any number can be traced back.
  propertyListingId String? @map("property_listing_id")
  /// Initial Location Investment (PROJECT_MASTER_SPEC.md §12): deposit plus
  /// renovation, derived from explicit cost assumptions. Null when the candidate
  /// lacks the rent/size data needed to estimate it.
  estimatedLocationInvestment Float? @map("estimated_location_investment")

  /// How precisely the address was located: ROOFTOP is the building itself,
  /// while GEOMETRIC_CENTER on a street name is the midpoint of the whole road.
  /// Kept because every distance in the report is measured from this point, and
  /// a road-midpoint geocode makes all of them meaningless.
  geocodePrecision String? @map("geocode_precision")
  /// The road as the geocoder names it, which is more reliable than parsing the
  /// address text the client typed.
  geocodedRoadName String? @map("geocoded_road_name")

  status          String   @default("IDENTIFIED") // IDENTIFIED, SHORTLISTED, REJECTED, RECOMMENDED
  confidence      String   @default("LOW") // HIGH, MEDIUM, LOW
  compositeScore  Float?   @map("composite_score")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  financialScenarios FinancialScenario[]
  propertyListing PropertyListing? @relation(fields: [propertyListingId], references: [id], onDelete: SetNull)

  @@map("location_candidates")
}

model Competitor {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  placeId         String?  @map("place_id")
  name            String
  /// Needed to tell which businesses front the same road as the premises.
  address         String?
  category        String
  type            String   @default("DIRECT") // DIRECT, INDIRECT, SUBSTITUTE
  latitude        Float
  longitude       Float
  geom            Unsupported("geometry(Point, 4326)")?
  distanceMeters  Int?     @map("distance_meters")
  rating          Float?
  reviewCount     Int?     @map("review_count")
  /// When the provider's content was fetched.
  ///
  /// Google's Places policy exempts only the place ID from its caching
  /// restriction; name, address, rating, review count and coordinates are
  /// provider content and may not be retained indefinitely. This timestamp is
  /// what makes expiry possible: `createdAt` records the row, not the content.
  contentFetchedAt DateTime? @map("content_fetched_at")
  /// True once the provider content above has been cleared by the retention
  /// sweep. The place ID survives, so a re-run can fetch it again.
  contentPurged    Boolean  @default(false) @map("content_purged")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([contentFetchedAt])
  @@map("competitors")
}

model FinancialScenario {
  id                  String   @id @default(uuid())
  candidateId         String   @map("candidate_id")
  type                String   // CONSERVATIVE, BASE, UPSIDE
  monthlyRevenue      Float    @map("monthly_revenue")
  monthlyOperatingCost Float   @map("monthly_operating_cost")
  grossProfit         Float    @map("gross_profit")
  netProfit           Float    @map("net_profit")
  paybackPeriodMonths Float?   @map("payback_period_months")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  candidate           LocationCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("financial_scenarios")
}

model Report {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  version         String   @default("1.0")
  status          String   @default("DRAFT") // DRAFT, REVIEW, APPROVED, DELIVERED
  contentJson     Json?    @map("content_json") // Stored structured report data
  /// The QA verdict, kept so the owner can see why a report was held back
  /// instead of finding an approve button simply absent.
  qaReview        Json?    @map("qa_review")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("reports")
}

/// Provenance record for every external data retrieval
/// (DEVELOPMENT_RULES.md §10, PROJECT_MASTER_SPEC.md §25).
model DataSource {
  id              String   @id @default(uuid())
  /// Which project the retrieval was made for. Null for global/background pulls.
  projectId       String?  @map("project_id")
  source          String   // e.g. "Google Maps", "BPS"
  dataType        String   @map("data_type") // e.g. "demographics", "place_details"
  geographicScope String?  @map("geographic_scope")
  confidence      String   @default("LOW") // HIGH, MEDIUM, LOW
  retrievedAt     DateTime @default(now()) @map("retrieved_at")
  metadata        Json?    // Optional extra info

  project         Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("data_sources")
}

/// An observed property offer, used as an AREA RENT BENCHMARK.
///
/// Clients supply the premises they want assessed (VALIDATION, COMPARISON), so
/// every order deposits real rents for a real area here. Those accumulated
/// observations are what let AREA_SCOUTING quote a concrete rent range per
/// micro-area instead of a generic verdict — the product moat in §30.
///
/// Sources are limited to those PROJECT_MASTER_SPEC.md §7 allows: licensed
/// providers, agents, owner submissions, customer-provided data and field
/// surveys. Marketplace scraping is NOT a permitted source.
model PropertyListing {
  id              String   @id @default(uuid())
  /// Set when the listing was contributed for one project; null for listings
  /// contributed to the shared dataset.
  projectId       String?  @map("project_id")

  /// How the listing entered the system. Never "SCRAPED".
  source          String   // CUSTOMER_SUBMITTED, AGENT_SUBMITTED, OWNER_SUBMITTED, FIELD_SURVEY, LICENSED_PROVIDER, MOCK
  /// Provider listing id, agent name, or survey reference.
  sourceReference String?  @map("source_reference")

  placeId         String?  @map("place_id")
  address         String
  latitude        Float
  longitude       Float
  geom            Unsupported("geometry(Point, 4326)")?

  propertyType    String?  @map("property_type") // Ruko, Kios, Shophouse, Warehouse, ...
  sizeSqm         Int?     @map("size_sqm")
  /// Normalised to a MONTHLY figure. Indonesian leases are often quoted
  /// annually, so `annualRent` is kept alongside and divided when only it is known.
  monthlyRent     Float?   @map("monthly_rent")
  annualRent      Float?   @map("annual_rent")
  /// True when monthlyRent was derived from annualRent rather than quoted directly.
  rentIsDerived   Boolean  @default(false) @map("rent_is_derived")
  deposit         Float?

  availability    String   @default("UNKNOWN") // AVAILABLE, RESERVED, TAKEN, UNKNOWN
  confidence      String   @default("LOW")     // HIGH, MEDIUM, LOW

  retrievedAt     DateTime  @default(now()) @map("retrieved_at")
  /// Set once someone has physically confirmed the listing (§17 field validation).
  verifiedAt      DateTime? @map("verified_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project         Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  candidates      LocationCandidate[]

  @@index([projectId])
  @@index([availability])
  @@map("property_listings")
}

model JobQueue {
  id          String   @id @default(uuid())
  type        String   // e.g., "GENERATE_REPORT"
  status      String   @default("PENDING") // PENDING, PROCESSING, RETRYING, COMPLETED, FAILED
  payload     Json     // Project ID, Client ID, etc.
  error       String?  // Store error stack trace if failed
  /// Completed run attempts, incremented on every failure.
  attempts    Int      @default(0)
  /// Attempts allowed before the job is marked FAILED for good.
  maxAttempts Int      @default(3) @map("max_attempts")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("job_queue")
}
/// Billable calls to paid providers, aggregated per day and SKU.
///
/// Aggregated rather than one row per call: a census makes dozens of requests
/// and the only questions anyone asks of this table are "how much this month"
/// and "which project spent it". Both are answered by sums.
///
/// This is the record the cost ceiling is enforced against, so it must survive
/// a restart — an in-memory counter would reset the budget every deploy.
model ApiUsage {
  id               String   @id @default(uuid())
  /// The UTC day, midnight, so a day's rows group without a date function.
  day              DateTime
  sku              String
  /// Null for calls not made on behalf of one project.
  projectId        String?  @map("project_id")
  calls            Int      @default(0)
  estimatedCostUsd Float    @default(0) @map("estimated_cost_usd")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([day, sku, projectId])
  @@index([day])
  @@index([projectId])
  @@map("api_usage")
}
